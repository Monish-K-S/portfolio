---
import type { Project } from "../types";

interface Props {
    project: Project;
}

const { project } = Astro.props;
---

<div
    class="mt-6 bg-surface border border-border rounded-2xl p-6 transition hover:-translate-y-1 hover:border-accent"
>
    {
        project.image && (
            <div class="mb-6 h-56 overflow-hidden rounded-xl border border-border">
                <img
                    src={project.image}
                    alt={project.title}
                    class="h-full w-full object-cover object-top"
                />
            </div>
        )
    }
    <h3 class="text-xl font-bold text-text-primary">
        {project.title}
    </h3>
    <p class="mt-5 text-xs uppercase tracking-west text-text-muted">
        Highlights
    </p>
    <p class="mt-2 text-sm text-accent">
        {project.highlights.join(" • ")}
    </p>
    <p class="mt-3 text-text-secondary leading-7">
        {project.description}
    </p>



    <div class="mt-4 flex flex-wrap gap-2">
        {
            project.technologies.map((tech) => (
                <span
                    class="text-sm border border-border-strong rounded-md px-2 py-1 text-text-tertiary"
                >
                    {tech}
                </span>
            ))
        }
    </div>

    <a
        href={project.github}
        class="inline-block mt-5 text-sm text-accent hover:text-accent-hover transition"
        target="_blank"
        rel="noopener noreferrer"
    >
        GitHub →
    </a>
</div>
