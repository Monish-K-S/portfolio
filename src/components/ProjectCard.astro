---
import type { Project } from "../types";

interface Props {
    project: Project;
}

const { project } = Astro.props;
---

<div
    class="mt-6 bg-[#0A0A0A] border border-zinc-800 rounded-2xl p-6 transition hover:-translate-y-1 hover:border-[#F28705]"
>
    <h3 class="text-xl font-bold text-white">
        {project.title}
    </h3>
    <p class="mt-5 text-xs uppercase tracking-west text-zinc-500">
        Highlights
    </p>
    <p class="mt-2 text-sm text-[#F28705]">
        {project.highlights.join(" • ")}
    </p>
    <p class="mt-3 text-zinc-400 leading-7">
        {project.description}
    </p>



    <div class="mt-4 flex flex-wrap gap-2">
        {
            project.technologies.map((tech) => (
                <span
                    class="text-sm border border-zinc-700 rounded-md px-2 py-1 text-zinc-300"
                >
                    {tech}
                </span>
            ))
        }
    </div>

    <a
        href={project.github}
        class="inline-block mt-5 text-sm text-[#F28705] hover:text-[#F25C05] transition"
        target="_blank"
        rel="noopener noreferrer"
    >
        GitHub →
    </a>
</div>
