---
import type { Project } from "../types";

interface Props {
    project: Project;
}

const { project } = Astro.props;
---

<div class="card mt-6">
    <span class="card__hairline"></span>

    {
        project.image && (
            <div class="card__media h-56">
                <img
                    src={project.image}
                    alt={project.title}
                    width={project.imageWidth}
                    height={project.imageHeight}
                    loading="lazy"
                    decoding="async"
                />
            </div>
        )
    }

    <div class="card__body p-6">
        <h3 class="text-xl font-bold text-text-primary">
            {project.title}
        </h3>

        <p class="mt-5 text-xs uppercase tracking-widest text-text-muted mono-label">
            Highlights
        </p>

        <p class="mt-2 text-sm text-accent">
            {project.highlights.join(" • ")}
        </p>

        <p class="mt-3 text-text-secondary leading-7">
            {project.description}
        </p>

        <div class="mt-4 flex flex-wrap gap-2">
            {
                project.technologies.map((tech) => (
                    <span
                        class="pill text-sm border border-border-strong rounded-md px-2 py-1 text-text-tertiary"
                    >
                        {tech}
                    </span>
                ))
            }
        </div>

        <a
            href={project.github}
            class="inline-block mt-5 text-sm text-accent hover:text-accent-hover transition"
            target="_blank"
            rel="noopener noreferrer"
        >
            GitHub →
        </a>
    </div>
</div>