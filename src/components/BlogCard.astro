---
import type { BlogPost } from "../types";

type Props = BlogPost;

const { title, description, date, url, cover } = Astro.props;
---

<a
    href={url}
    class="block bg-[#0A0A0A] border border-zinc-800 rounded-2xl p-6 transition hover:-translate-y-1 hover:border-[#F28705]"
>
    {
        cover && (
            <div class="mb-6 h-56 overflow-hidden rounded-xl border border-zinc-800">
                <img
                    src={cover}
                    alt={title}
                    class="h-full w-full object-cover object-top"
                />
            </div>
        )
    }

    <h2 class="text-2xl font-bold text-white">
        {title}
    </h2>

    <p class="mt-3 text-zinc-400 leading-7">
        {description}
    </p>

    <p class="mt-4 text-sm text-zinc-500">
        {new Date(date).toLocaleDateString()}
    </p>
</a>
