---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="404 — Page not found | Monish Gowda"
    description="The page you're looking for doesn't exist or may have been moved."
>
    <section class="text-center py-24">
        <p
            class="text-accent text-sm tracking-widest uppercase font-semibold"
        >
            Error
        </p>

        <h1
            class="glitch mt-4 text-7xl font-bold"
            data-scramble="404"
        >
            404
        </h1>

        <p class="mt-6 text-text-secondary max-w-md mx-auto">
            The page you're looking for doesn't exist or may have been moved.
        </p>

        <a
            href="/"
            class="inline-block mt-8 text-accent hover:text-accent-hover transition"
        >
            ← Return Home
        </a>
    </section>
</Layout>
