---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <section class="text-center py-24">
        <p
            class="text-[#F28705] text-sm tracking-widest uppercase font-semibold"
        >
            Error
        </p>

        <h1 class="mt-4 text-7xl font-bold">
            404
        </h1>

        <p class="mt-6 text-zinc-400 max-w-md mx-auto">
            The page you're looking for doesn't exist or may have been moved.
        </p>

        <a
            href="/"
            class="inline-block mt-8 text-[#F28705] hover:text-[#F25C05] transition"
        >
            ← Return Home
        </a>
    </section>
</Layout>
