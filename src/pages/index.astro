---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";

import profileData from "../data/profile.json";
import projectsData from "../data/projects.json";

import type { Profile, Project } from "../types";

const profile = profileData as Profile;
const projects = projectsData as Project[];

const blogPosts = Object.values(
    import.meta.glob("./blogs/*.md", { eager: true })
);

blogPosts.sort(
    (a: any, b: any) =>
        new Date(b.frontmatter.date).getTime() -
        new Date(a.frontmatter.date).getTime()
);

const latestPosts = blogPosts.slice(0, 3);
---

<Layout>
    <section>
        <h1 class="text-7xl font-bold tracking-tight text-white">
            {profile.name}
        </h1>

        <p class="mt-4 text-xl text-[#F28705]">
            {profile.title}
        </p>

        <p class="mt-6 max-w-3xl text-zinc-400 leading-8">
            {profile.about}
        </p>

        <div class="mt-8 flex flex-wrap gap-6">
            <a
                href={profile.github}
                class="text-[#F28705] hover:text-[#F25C05] transition"
                target="_blank"
                rel="noopener noreferrer"
            >
                GitHub
            </a>

            <a
                href={profile.linkedin}
                class="text-[#F28705] hover:text-[#F25C05] transition"
                target="_blank"
                rel="noopener noreferrer"
            >
                LinkedIn
            </a>

            <a
                href="/resume.pdf"
                class="text-[#F28705] hover:text-[#F25C05] transition"
                target="_blank"
                rel="noopener noreferrer"
            >
                Resume
            </a>
        </div>
    </section>

    <section class="mt-24">
        <div
            class="mb-3 text-[#F28705] text-sm tracking-widest uppercase font-semibold"
        >
            Projects
        </div>

        <h2 class="text-3xl font-semibold text-white">
            Selected Work
        </h2>

        <div class="mt-6">
            {
                projects.map((project) => (
                    <ProjectCard project={project} />
                ))
            }
        </div>
    </section>

    <section class="mt-24">
        <div
            class="mb-3 text-[#F28705] text-sm tracking-widest uppercase font-semibold"
        >
            Writing
        </div>

        <h2 class="text-3xl font-semibold text-white">
            Latest Posts
        </h2>

        <div class="mt-6 space-y-4">
            {
                latestPosts.map((post: any) => (
                    <a
                        href={post.url}
                        class="block bg-[#0A0A0A] border border-zinc-800 rounded-2xl p-6 transition hover:-translate-y-1 hover:border-[#F28705]"
                    >
                        <h3 class="text-xl font-bold text-white">
                            {post.frontmatter.title}
                        </h3>

                        <p class="mt-3 text-zinc-400 leading-7">
                            {post.frontmatter.description}
                        </p>

                        <p class="mt-4 text-sm text-zinc-500">
                            {new Date(
                                post.frontmatter.date
                            ).toLocaleDateString()}
                        </p>
                    </a>
                ))
            }
        </div>

        <a
            href="/blogs"
            class="inline-block mt-6 text-[#F28705] hover:text-[#F25C05] transition"
        >
            View all posts →
        </a>
    </section>

    <section class="mt-24">
        <div
            class="mb-3 text-[#F28705] text-sm tracking-widest uppercase font-semibold"
        >
            Skills
        </div>

        <h2 class="text-3xl font-semibold text-white">
            Technologies
        </h2>

        <div class="mt-6 flex flex-wrap gap-3">
            {
                profile.skills.map((skill) => (
                    <span
                        class="border border-zinc-700 rounded-full px-4 py-2 text-sm text-zinc-300"
                    >
                        {skill}
                    </span>
                ))
            }
        </div>
    </section>

    <section class="mt-24">
        <div
            class="mb-3 text-[#F28705] text-sm tracking-widest uppercase font-semibold"
        >
            Education
        </div>

        <h2 class="text-3xl font-semibold text-white">
            Academic Background
        </h2>

        <div
            class="mt-6 bg-[#0A0A0A] border border-zinc-800 rounded-2xl p-6"
        >
            <h3 class="text-lg font-semibold text-white">
                MVJ College of Engineering
            </h3>

            <div class="mt-3 flex flex-wrap gap-4 text-zinc-400">
                <span>
                    B.E. Computer Science and Engineering (Data Science)
                </span>

                <span>
                    CGPA: 9.0 / 10
                </span>
            </div>

            <p class="mt-3 text-sm text-zinc-500">
                2023 – 2027
            </p>
        </div>
    </section>

    <section class="mt-24">
        <div
            class="mb-3 text-[#F28705] text-sm tracking-widest uppercase font-semibold"
        >
            Contact
        </div>

        <h2 class="text-3xl font-semibold text-white">
            Let's Connect
        </h2>

        <div class="mt-6 flex flex-wrap gap-6">
            <a
                href={profile.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#F28705] hover:text-[#F25C05] transition"
            >
                GitHub
            </a>

            <a
                href={profile.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#F28705] hover:text-[#F25C05] transition"
            >
                LinkedIn
            </a>

            <a
                href={`mailto:${profile.email}`}
                class="text-[#F28705] hover:text-[#F25C05] transition"
            >
                Email
            </a>

            <a
                href="/resume.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#F28705] hover:text-[#F25C05] transition"
            >
                Resume
            </a>
        </div>
    </section>
</Layout>
