---
import "../styles/global.css";
import profileData from "../data/profile.json";
import type { Profile } from "../types";
import { ClientRouter } from "astro:transitions";



const profile = profileData as Profile;
const currentPath = Astro.url.pathname;
---

<html lang="en">
    <head>
        <ClientRouter />
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <title>Monish Gowda | Backend Engineer</title>

        <meta
            name="description"
            content="Backend Engineer passionate about distributed systems, Spring Boot, Go, Kafka, PostgreSQL, and scalable software engineering."
        />

        <meta
            name="keywords"
            content="Backend Engineer, Java, Spring Boot, Go, Kafka, PostgreSQL, Distributed Systems, Software Engineer, Portfolio"
        />

        <meta name="author" content="Monish Gowda" />
        <meta property="og:type" content="website" />

        <meta property="og:title"
              content="Monish Gowda | Backend Engineer" />

        <meta property="og:description"
              content="Backend Engineer passionate about distributed systems, Spring Boot, Kafka, Go and scalable software." />

        <meta property="og:url"
              content="https://monish.page" />

        <meta property="og:image"
              content="https://monish.page/og-image.png" />
              <meta name="twitter:card" content="summary_large_image" />

              <meta
                  name="twitter:title"
                  content="Monish Gowda | Backend Engineer"
              />

              <meta
                  name="twitter:description"
                  content="Backend Engineer passionate about distributed systems and scalable software."
              />

              <meta
                  name="twitter:image"
                  content="https://monish.page/og-image.png"
              />

        <link rel="canonical" href="https://monish.page" />

        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

        <script is:inline>
            try {
                if (localStorage.getItem("theme") === "light") {
                    document.documentElement.classList.remove("dark");
                } else {
                    document.documentElement.classList.add("dark");
                }
            } catch {
                document.documentElement.classList.add("dark");
            }
        </script>
    </head>

    <body class="bg-background text-text-primary min-h-screen">
        <nav class="border-b border-border">
            <div class="max-w-4xl mx-auto px-6 py-5">
                <div class="flex flex-wrap justify-center items-center gap-8 text-sm">
                    <a
                        href="/"
                        class={currentPath === "/"
                                ? "text-accent"
                                : "text-text-secondary hover:text-accent transition"}
                    >
                        Home
                    </a>

                    <a
                        href="/blogs"
                        class={currentPath.startsWith("/blogs")
                                ? "text-accent"
                                : "text-text-secondary hover:text-accent transition"}
                    >
                        Blogs
                    </a>

                    <a
                        href="/resume.pdf"
                        target="_blank"
                        class="text-text-secondary hover:text-accent transition"
                    >
                        Resume
                    </a>

                    <a
                        href={profile.github}
                        target="_blank"
                        class="text-text-secondary hover:text-accent transition"
                    >
                        GitHub
                    </a>

                    <button
                        id="theme-toggle"
                        type="button"
                        aria-label="Toggle theme"
                        class="flex items-center cursor-pointer text-text-secondary hover:text-accent transition"
                    >
                        <svg
                            class="dark:hidden"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                            />
                        </svg>
                        <svg
                            class="hidden dark:block"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <circle cx="12" cy="12" r="5" />
                            <line x1="12" y1="1" x2="12" y2="3" />
                            <line x1="12" y1="21" x2="12" y2="23" />
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
                            <line
                                x1="18.36" y1="18.36" x2="19.78" y2="19.78"
                            />
                            <line x1="1" y1="12" x2="3" y2="12" />
                            <line x1="21" y1="12" x2="23" y2="12" />
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
                            <line
                                x1="18.36" y1="5.64" x2="19.78" y2="4.22"
                            />
                        </svg>
                    </button>
                </div>
            </div>
        </nav>

        <main class="max-w-4xl mx-auto px-6 py-16">
            <slot />
        </main>

        <footer
            class="max-w-4xl mx-auto px-6 py-10 mt-24 border-t border-border text-sm text-text-muted"
        >
            © 2026 Monish Gowda
        </footer>

        <script is:inline>
            function applyStoredTheme() {
                try {
                    if (localStorage.getItem("theme") === "light") {
                        document.documentElement.classList.remove("dark");
                    } else {
                        document.documentElement.classList.add("dark");
                    }
                } catch {
                    document.documentElement.classList.add("dark");
                }
            }
            function bindThemeToggle() {
                const btn = document.getElementById("theme-toggle");
                if (!btn || btn.dataset.bound) return;
                btn.dataset.bound = "true";
                btn.addEventListener("click", () => {
                    const isDark =
                        document.documentElement.classList.toggle("dark");
                    try {
                        localStorage.setItem(
                            "theme",
                            isDark ? "dark" : "light"
                        );
                    } catch {
                        // ignore
                    }
                });
            }
            applyStoredTheme();
            bindThemeToggle();
            document.addEventListener("astro:after-swap", () => {
                applyStoredTheme();
                bindThemeToggle();
            });
            document.addEventListener("astro:page-load", applyStoredTheme);
        </script>
    </body>
</html>
