---
import "../styles/global.css";
import profileData from "../data/profile.json";
import type { Profile } from "../types";
import { ClientRouter } from "astro:transitions";



const profile = profileData as Profile;
const currentPath = Astro.url.pathname;
---

<html lang="en">
    <head>
        <ClientRouter />
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <title>Monish Gowda | Backend Engineer</title>

        <meta
            name="description"
            content="Backend Engineer passionate about distributed systems, Spring Boot, Go, Kafka, PostgreSQL, and scalable software engineering."
        />

        <meta
            name="keywords"
            content="Backend Engineer, Java, Spring Boot, Go, Kafka, PostgreSQL, Distributed Systems, Software Engineer, Portfolio"
        />

        <meta name="author" content="Monish Gowda" />
        <meta property="og:type" content="website" />

        <meta property="og:title"
              content="Monish Gowda | Backend Engineer" />

        <meta property="og:description"
              content="Backend Engineer passionate about distributed systems, Spring Boot, Kafka, Go and scalable software." />

        <meta property="og:url"
              content="https://monish.page" />

        <meta property="og:image"
              content="https://monish.page/og-image.png" />
              <meta name="twitter:card" content="summary_large_image" />

              <meta
                  name="twitter:title"
                  content="Monish Gowda | Backend Engineer"
              />

              <meta
                  name="twitter:description"
                  content="Backend Engineer passionate about distributed systems and scalable software."
              />

              <meta
                  name="twitter:image"
                  content="https://monish.page/og-image.png"
              />

        <link rel="canonical" href="https://monish.page" />

        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    </head>

    <body class="bg-black text-white min-h-screen">
        <nav class="border-b border-zinc-900">
            <div class="max-w-4xl mx-auto px-6 py-5">
                <div class="flex justify-center items-center gap-8 text-sm">
                    <a
                        href="/"
                        class={currentPath === "/"
                                ? "text-[#F28705]"
                                : "text-zinc-400 hover:text-[#F28705] transition"}
                    >
                        Home
                    </a>

                    <a
                        href="/blogs"
                        class={currentPath.startsWith("/blogs")
                                ? "text-[#F28705]"
                                : "text-zinc-400 hover:text-[#F28705] transition"}
                    >
                        Blogs
                    </a>

                    <a
                        href="/resume.pdf"
                        target="_blank"
                        class="text-zinc-400 hover:text-[#F28705] transition"
                    >
                        Resume
                    </a>

                    <a
                        href={profile.github}
                        target="_blank"
                        class="text-zinc-400 hover:text-[#F28705] transition"
                    >
                        GitHub
                    </a>
                </div>
            </div>
        </nav>

        <main class="max-w-4xl mx-auto px-6 py-16">
            <slot />
        </main>

        <footer
            class="max-w-4xl mx-auto px-6 py-10 mt-24 border-t border-zinc-900 text-sm text-zinc-500"
        >
            © 2026 Monish Gowda
        </footer>
    </body>
</html>
