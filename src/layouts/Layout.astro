    </head>

    <body>
        <nav class="border-b">
            <div class="max-w-4xl mx-auto px-6 py-4">
                <div class="flex justify-center items-center gap-8 text-sm">
                    <a href="/" class="hover:underline">
                        Home
                    </a>

                    <a href="/blogs" class="hover:underline">
                        Blogs
                    </a>

                    <a
